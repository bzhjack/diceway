{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "delete-blade": "rimraf ../resources/views/diceway.blade.php",
    "rename-blade": "node -e \"require('fs').rename('../resources/views/index.html', '../resources/views/diceway.blade.php', function(err) { if (err) console.log(err); console.log('File successfully renamed!') })\"",
    "create-blade": "copyfiles -f ../public/frontend/index.html ../resources/views",
    "build:prod": "ng build --configuration production && npm run delete-blade && npm run create-blade && npm run rename-blade",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "17.1.0",
    "@angular/common": "17.1.0",
    "@angular/compiler": "17.1.0",
    "@angular/core": "17.1.0",
    "@angular/forms": "17.1.0",
    "@angular/platform-browser": "17.1.0",
    "@angular/platform-browser-dynamic": "17.1.0",
    "@angular/router": "17.1.0",
    "rxjs": "7.8.0",
    "tslib": "2.3.0",
    "zone.js": "0.14.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "17.1.2",
    "@angular/cli": "17.1.2",
    "@angular/compiler-cli": "17.1.0",
    "@types/jasmine": "5.1.0",
    "copyfiles": "2.4.1",
    "jasmine-core": "5.1.0",
    "karma": "6.4.0",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage": "2.2.0",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.1.0",
    "rimraf": "5.0.5",
    "typescript": "5.3.2"
  }
}
