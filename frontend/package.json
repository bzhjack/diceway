{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "delete-blade": "rimraf ../resources/views/diceway.blade.php",
    "link-blade": "node ./build.js",
    "rename-blade": "node -e \"require('fs').rename('../resources/views/index.html', '../resources/views/diceway.blade.php', function(err) { if (err) console.log(err); console.log('File successfully renamed!') })\"",
    "create-blade": "copyfiles -f ../public/frontend/index.html ../resources/views",
    "build:prod": "ng build --configuration production && npm run delete-blade && npm run create-blade && npm run rename-blade && npm run link-blade",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "18.2.2",
    "@angular/cdk": "18.2.2",
    "@angular/common": "18.2.2",
    "@angular/compiler": "18.2.2",
    "@angular/core": "18.2.2",
    "@angular/forms": "18.2.2",
    "@angular/platform-browser": "18.2.2",
    "@angular/platform-browser-dynamic": "18.2.2",
    "@angular/router": "18.2.2",
    "ng-inline-svg-2": "15.0.1",
    "ngx-image-cropper": "7.2.1",
    "ngx-spinner": "16.0.2",
    "primeicons": "7.0.0",
    "primeng": "17.18.9",
    "rxjs": "7.8.1",
    "tslib": "2.6.2",
    "zone.js": "0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "18.2.1",
    "@angular/cli": "18.2.1",
    "@angular/compiler-cli": "18.2.2",
    "@types/jasmine": "5.1.0",
    "autoprefixer": "10.4.18",
    "copyfiles": "2.4.1",
    "jasmine-core": "5.1.0",
    "karma": "6.4.0",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage": "2.2.0",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.1.0",
    "postcss": "8.4.35",
    "rimraf": "5.0.5",
    "tailwindcss": "3.4.1",
    "typescript": "5.4.5"
  }
}
