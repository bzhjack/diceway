// DEPRECATED: Use AuthService directly. This shim forwards calls to AuthService to keep backward compatibility.
import { Injectable, inject } from '@angular/core';
import { Observable } from 'rxjs';
import { AuthService } from './auth.service';

@Injectable({ providedIn: 'root' })
export class UserService {
  private readonly auth = inject(AuthService);

  constructor() {}

  // Backward-compatible signatures forwarding to AuthService
  login(credentials: { email: string; password: string }): Observable<any> {
    return this.auth.loginWithCredentials(credentials);
  }

  register(credentials: { name: string; email: string; password: string; password_confirmation: string }): Observable<any> {
    return this.auth.register(credentials);
  }

  sendMail(email: string): Observable<any> {
    return this.auth.sendMail(email);
  }

  profile(token: string): Observable<any> {
    return this.auth.profile(token);
  }

  forgottenPassword(email: string): Observable<any> {
    return this.auth.forgottenPassword(email);
  }

  resetPassord(credentials: { token: string; email: string; password: string; password_confirmation: string }): Observable<any> {
    return this.auth.resetPassord(credentials);
  }

  logout(): void {
    this.auth.logout();
  }
}
